{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyTokyo",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetVpnConnectionDeviceTypes",
        "ec2:GetVpnConnectionDeviceSampleConfiguration"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1"
        }
      }
    },
    {
      "Sid": "CreateTaggedPocResources",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:AllocateAddress",
        "ec2:CreateVpnGateway",
        "ec2:CreateCustomerGateway",
        "ec2:CreateVpnConnection",
        "ec2:CreateInstanceConnectEndpoint",
        "ec2:CreateKeyPair",
        "ec2:ImportKeyPair"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "aws:RequestTag/Project": "b3c-500-poc"
        }
      }
    },
    {
      "Sid": "RunInstancesInstanceTaggedAndTypeLimited",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-northeast-1:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "aws:RequestTag/Project": "b3c-500-poc",
          "ec2:InstanceType": [
            "t3.micro",
            "t3.medium",
            "c5.large"
          ]
        }
      }
    },
    {
      "Sid": "RunInstancesVolumeTagged",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-northeast-1:*:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "aws:RequestTag/Project": "b3c-500-poc"
        }
      }
    },
    {
      "Sid": "RunInstancesUsePocNetworkAndImage",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ap-northeast-1:*:subnet/*",
        "arn:aws:ec2:ap-northeast-1:*:security-group/*",
        "arn:aws:ec2:ap-northeast-1:*:key-pair/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "b3c-500-poc"
        }
      }
    },
    {
      "Sid": "RunInstancesImageAndNic",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ap-northeast-1::image/*",
        "arn:aws:ec2:ap-northeast-1:*:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1"
        }
      }
    },
    {
      "Sid": "CreateTagsOnCreateOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "aws:RequestTag/Project": "b3c-500-poc",
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateInternetGateway",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "AllocateAddress",
            "CreateVpnGateway",
            "CreateCustomerGateway",
            "CreateVpnConnection",
            "CreateInstanceConnectEndpoint",
            "CreateKeyPair",
            "ImportKeyPair",
            "RunInstances"
          ]
        }
      }
    },
    {
      "Sid": "TagDefaultResourcesRightAfterVpcCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ap-northeast-1:*:route-table/*",
        "arn:aws:ec2:ap-northeast-1:*:network-acl/*",
        "arn:aws:ec2:ap-northeast-1:*:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "aws:RequestTag/Project": "b3c-500-poc"
        },
        "Null": {
          "ec2:ResourceTag/Project": "true"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project",
            "Name"
          ]
        }
      }
    },
    {
      "Sid": "TagOwnPocResourcesNameOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "ec2:ResourceTag/Project": "b3c-500-poc",
          "aws:RequestTag/Project": "b3c-500-poc"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project",
            "Name"
          ]
        }
      }
    },
    {
      "Sid": "OperateTaggedPocResourcesAndParents",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachInternetGateway",
        "ec2:AttachVpnGateway",
        "ec2:AssociateRouteTable",
        "ec2:AssociateAddress",
        "ec2:CreateRoute",
        "ec2:CreateVpnConnectionRoute",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:ModifyInstanceAttribute",
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateInstanceConnectEndpoint",
        "ec2:CreateNetworkInterface",
        "ec2:CreateVpnConnection",
        "ec2:GetVpnConnectionDeviceSampleConfiguration",
        "ec2:Delete*",
        "ec2:Detach*",
        "ec2:Disassociate*",
        "ec2:Revoke*",
        "ec2:ReleaseAddress",
        "ec2:TerminateInstances",
        "ec2-instance-connect:OpenTunnel"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "ec2:ResourceTag/Project": "b3c-500-poc"
        }
      }
    },
    {
      "Sid": "ChildResourcesWithoutTagKeys",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:GetVpnConnectionDeviceSampleConfiguration",
        "ec2:CreateNetworkInterface"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-1:*:security-group-rule/*",
        "arn:aws:ec2:ap-northeast-1:*:vpn-connection-device-type/*",
        "arn:aws:ec2:ap-northeast-1:*:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1"
        }
      }
    },
    {
      "Sid": "SendKeyEc2UserOnly",
      "Effect": "Allow",
      "Action": "ec2-instance-connect:SendSSHPublicKey",
      "Resource": "arn:aws:ec2:ap-northeast-1:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "ec2:osuser": "ec2-user"
        }
      }
    },
    {
      "Sid": "ServiceLinkedRoleForInstanceConnectEndpoint",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "ec2-instance-connect.amazonaws.com"
        }
      }
    },
    {
      "Sid": "MarketplaceViewOnly",
      "Effect": "Allow",
      "Action": "aws-marketplace:ViewSubscriptions",
      "Resource": "*"
    },
    {
      "Sid": "PriceAndCostReadOnly",
      "Effect": "Allow",
      "Action": [
        "pricing:GetProducts",
        "ce:GetCostAndUsage",
        "sts:GetCallerIdentity",
        "sts:DecodeAuthorizationMessage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyCostlyOrOutOfScopeEc2",
      "Effect": "Deny",
      "Action": [
        "ec2:Purchase*",
        "ec2:CreateNatGateway",
        "ec2:CreateTransitGateway*",
        "ec2:CreateVpcEndpoint*",
        "ec2:CreateVpcPeeringConnection",
        "ec2:AllocateHosts",
        "ec2:CreateCapacityReservation*",
        "ec2:RequestSpotInstances",
        "ec2:RequestSpotFleet",
        "ec2:CreateFleet",
        "ec2:CreateClientVpnEndpoint"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyDeleteTags",
      "Effect": "Deny",
      "Action": "ec2:DeleteTags",
      "Resource": "*"
    },
    {
      "Sid": "DenyOtherRegionsEc2",
      "Effect": "Deny",
      "Action": "ec2:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "ap-northeast-1"
        }
      }
    }
  ]
}
